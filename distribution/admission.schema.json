{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perfeng.dev/distribution/v1/admission.schema.json",
  "title": "Changed contract admission policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "candidateSha256", "checks"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "candidateSha256": { "$ref": "#/$defs/sha256" },
    "checks": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]{0,63}$", "not": { "pattern": "[^a-z0-9-]" } },
      "additionalProperties": { "$ref": "#/$defs/check" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$" },
    "revision": { "type": "string", "minLength": 40, "maxLength": 40, "pattern": "^[a-f0-9]{40}$" },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "sourceRevision",
        "workflow",
        "signerRevision",
        "baselineSha256",
        "direction",
        "command"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "not": { "pattern": "[^A-Za-z0-9_./-]" },
          "maxLength": 128
        },
        "sourceRevision": { "$ref": "#/$defs/revision" },
        "workflow": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/[.]github/workflows/[A-Za-z0-9_.-]+[.]ya?ml$",
          "not": { "pattern": "[^A-Za-z0-9_./-]" },
          "maxLength": 256
        },
        "signerRevision": { "$ref": "#/$defs/revision" },
        "baselineSha256": { "$ref": "#/$defs/sha256" },
        "direction": { "enum": ["backward", "forward"] },
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "not": { "pattern": "[\\r\\n]" }
        }
      }
    }
  }
}
