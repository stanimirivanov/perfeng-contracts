{
  "apiVersion": "performance.perfeng.io/v2",
  "kind": "TestCatalogue",
  "metadata": {"name": "example-tests", "version": "2.0.0"},
  "tests": [
    {
      "id": "checkout-api",
      "name": "Checkout API",
      "owner": "payments-team",
      "criticality": "critical",
      "tool": {"name": "k6", "version": "2.2.0"},
      "source": {
        "repository": "https://github.com/stanimirivanov/perfeng-k6",
        "gitSha": "1111111111111111111111111111111111111111",
        "entrypoint": "tests/checkout/scenario.js"
      },
      "artifact": {
        "kind": "oci-image",
        "image": "ghcr.io/example/perfeng-k6@sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd"
      },
      "workloads": [
        {
          "schemaVersion": 1,
          "id": "checkout-smoke",
          "version": "1.0.0",
          "tool": "k6",
          "profile": "smoke",
          "model": "open",
          "configuration": {
            "path": "workloads/smoke/checkout.json",
            "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
          },
          "phases": {"unit": "seconds", "warmup": 0, "measurement": 120, "cooldown": 0},
          "dataset": {"kind": "none"}
        }
      ],
      "schedule": {"pr": "smoke"},
      "metrics": [
        {
          "name": "biz.checkout.submit_to_confirmation.duration_p95",
          "direction": "lower-is-better",
          "type": "latency",
          "unit": "ms"
        }
      ]
    },
    {
      "id": "search-browser",
      "name": "Search action to visible results",
      "owner": "search-team",
      "criticality": "high",
      "tool": {"name": "playwright", "version": "1.62.1"},
      "source": {
        "repository": "https://github.com/stanimirivanov/perfeng-playwright",
        "gitSha": "874031ad492821d46c9bef7dbf9218280aa40a0e",
        "entrypoint": "src/cli.ts"
      },
      "artifact": {
        "kind": "source-checkout",
        "repository": "https://github.com/stanimirivanov/perfeng-playwright",
        "gitSha": "874031ad492821d46c9bef7dbf9218280aa40a0e",
        "dependencyLock": {
          "path": "pnpm-lock.yaml",
          "sha256": "722c5c7dfb2b25355801a7386eb2c30926904c58df12fb9a6aecc7a743212a63"
        }
      },
      "workloads": [
        {
          "schemaVersion": 1,
          "id": "search-browser-smoke",
          "version": "1.0.0",
          "tool": "playwright",
          "profile": "smoke",
          "model": "closed",
          "configuration": {
            "path": "playwright.config.mts",
            "sha256": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
          },
          "phases": {"unit": "iterations", "warmup": 2, "measurement": 10, "cooldown": 0},
          "dataset": {
            "kind": "versioned",
            "id": "search-fixture",
            "version": "1.0.0",
            "sha256": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
            "seed": 42
          }
        }
      ],
      "schedule": {"pr": "smoke"},
      "metrics": [
        {
          "name": "ui.search.action_to_visible_ms",
          "direction": "lower-is-better",
          "type": "latency",
          "unit": "ms"
        }
      ]
    }
  ]
}
