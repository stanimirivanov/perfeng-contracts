{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "reasons"
  ],
  "properties": {
    "status": {
      "enum": [
        "QUALIFIED",
        "UNQUALIFIED",
        "STALE"
      ]
    },
    "reasons": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "validUntil": {
      "$ref": "./Timestamp.json"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "QUALIFIED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "validUntil"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "UNQUALIFIED",
              "STALE"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "reasons": {
            "minItems": 1
          }
        }
      }
    }
  ]
}