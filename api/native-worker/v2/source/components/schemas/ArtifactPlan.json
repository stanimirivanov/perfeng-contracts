{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slot",
    "kind",
    "mediaType",
    "format",
    "maximumBytes",
    "required"
  ],
  "properties": {
    "slot": {
      "$ref": "./Identifier.json"
    },
    "kind": {
      "$ref": "./Identifier.json"
    },
    "mediaType": {
      "type": "string",
      "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$"
    },
    "format": {
      "$ref": "./ArtifactFormat.json"
    },
