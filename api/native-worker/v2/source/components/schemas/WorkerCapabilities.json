      }
    },
    "runnerContract": {
      "const": 2
    },
    "executionArtifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "const": "source-checkout"
      }
    },
    "artifactKinds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "./Identifier.json"
      }
    },
    "diagnosticModes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
