{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sourceReport",
    "reason"
  ],
  "properties": {
    "sourceReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "sha256": {
          "$ref": "./Sha256.json"
        }
      }
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "\\S"
    }
  }
}
