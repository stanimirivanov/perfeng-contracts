{
  "description": "Verified original bytes. No transformation, partial content, redirects or storage locations. See docs/run-evidence-reads.md.",
  "headers": {
    "Content-Length": {
      "required": true,
      "schema": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1048576
      }
    },
    "Content-Digest": {
      "required": true,
      "schema": {
        "type": "string",
        "pattern": "^sha-256=:[A-Za-z0-9+/]{43}=:$"
      }
    },
    "Cache-Control": {
      "required": true,
      "schema": {
        "type": "string",
        "const": "no-store"
      }
    },
    "X-Content-Type-Options": {
      "required": true,
      "schema": {
        "type": "string",
        "const": "nosniff"
      }
    },
    "X-Perfeng-Evidence-Media-Type": {
      "required": true,
      "schema": {
        "type": "string",
        "const": "application/json"
      }
    },
    "X-Perfeng-Evidence-Format": {
      "required": true,
      "schema": {
        "type": "string",
        "enum": [
          "normalized-result/v1",
          "analysis-result/v1"
        ]
      }
    },
    "X-Perfeng-Run-Id": {
      "required": true,
      "schema": {
        "$ref": "../schemas/RunId.json"
      }
    },
    "X-Perfeng-Artifact-Id": {
      "required": true,
      "schema": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
      }
    },
    "X-Perfeng-Artifact-Run-Id": {
      "required": true,
      "schema": {
        "$ref": "../schemas/RunId.json"
      }
    }
  },
  "content": {
    "application/octet-stream": {}
  }
}
