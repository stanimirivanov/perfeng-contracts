{
  "description": "Temporarily unavailable; retry after the indicated delay.",
  "content": {
    "application/json": {
      "schema": {
        "allOf": [
          {
            "$ref": "../schemas/Error.json"
          },
          {
            "properties": {
              "code": {
                "const": "UNAVAILABLE"
              }
            }
          }
        ]
      }
    }
  },
  "headers": {
    "Retry-After": {
      "required": true,
      "schema": {
        "type": "integer",
        "minimum": 1
      },
      "description": "Retry delay in seconds."
    }
  }
}