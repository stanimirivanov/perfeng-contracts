{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perfeng.dev/schemas/catalogue/v2/test-catalogue.schema.json",
  "$defs": {
    "id": {
      "type": "string",
      "description": "a string matching the pattern ^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "description": "a string matching the pattern ^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "relativePath": {
      "type": "string",
      "description": "a string matching the pattern ^(?!\\/)(?!.*(?:^|\\/)\\.{1,2}(?:\\/|$))[A-Za-z0-9_./-]+$",
      "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.{1,2}(?:\\/|$))[A-Za-z0-9_./-]+$"
    },
    "sha256": {
      "type": "string",
      "description": "a string matching the pattern ^[a-f0-9]{64}$",
      "pattern": "^[a-f0-9]{64}$"
    },
    "profile": {
      "type": "string",
      "enum": [
        "smoke",
        "average",
        "regression",
        "stress",
        "capacity",
        "soak"
      ]
    },
    "executionArtifact": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "image"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "oci-image"
              ]
            },
            "image": {
              "type": "string",
              "description": "a string matching the pattern ^[a-z0-9][a-z0-9._:/-]*@sha256:[a-f0-9]{64}$",
              "pattern": "^[a-z0-9][a-z0-9._:/-]*@sha256:[a-f0-9]{64}$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "repository",
            "gitSha",
            "dependencyLock"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "source-checkout"
              ]
            },
            "repository": {
              "type": "string",
              "format": "uri",
              "description": "a string matching the pattern ^https:\\/\\/",
              "pattern": "^https:\\/\\/"
            },
            "gitSha": {
              "type": "string",
              "description": "a string matching the pattern ^[a-f0-9]{40}$",
              "pattern": "^[a-f0-9]{40}$"
            },
            "dependencyLock": {
              "type": "object",
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "$ref": "#/$defs/relativePath"
                },
                "sha256": {
                  "$ref": "#/$defs/sha256"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "url",
            "archiveSha256",
            "executableSha256"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "release-archive"
              ]
            },
            "url": {
              "type": "string",
              "format": "uri",
              "description": "a string matching the pattern ^https:\\/\\/[^\\s@?#]+$",
              "pattern": "^https:\\/\\/[^\\s@?#]+$"
            },
            "archiveSha256": {
              "$ref": "#/$defs/sha256"
            },
            "executableSha256": {
              "$ref": "#/$defs/sha256"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "tests"
  ],
  "properties": {
    "apiVersion": {
      "type": "string",
      "enum": [
        "performance.perfeng.io/v2"
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "TestCatalogue"
      ]
    },
    "metadata": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "$ref": "#/$defs/version"
        }
      },
      "additionalProperties": false
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "owner",
          "criticality",
          "tool",
          "workloads",
          "source",
          "artifact"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "name": {
            "type": "string",
            "description": "a string matching the pattern \\S",
            "title": "minLength(1)",
            "minLength": 1,
            "pattern": "\\S"
          },
          "owner": {
            "type": "string",
            "description": "a string matching the pattern \\S",
            "title": "minLength(1)",
            "minLength": 1,
            "pattern": "\\S"
          },
          "criticality": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "description": {
            "type": "string"
          },
          "tool": {
            "type": "object",
            "required": [
              "name",
              "version"
            ],
            "properties": {
              "name": {
                "type": "string",
                "enum": [
                  "k6",
                  "playwright"
                ]
              },
              "version": {
                "$ref": "#/$defs/version"
              }
            },
            "additionalProperties": false
          },
          "workloads": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "schemaVersion",
                "id",
                "version",
                "tool",
                "profile",
                "model",
                "configuration",
                "phases",
                "dataset"
              ],
              "properties": {
                "schemaVersion": {
                  "type": "number",
                  "enum": [
                    1
                  ]
                },
                "id": {
                  "$ref": "#/$defs/id"
                },
                "version": {
                  "$ref": "#/$defs/version"
                },
                "tool": {
                  "type": "string",
                  "enum": [
                    "k6",
                    "playwright",
                    "kube-burner"
                  ]
                },
                "profile": {
                  "type": "string",
                  "enum": [
                    "smoke",
                    "average",
                    "regression",
                    "stress",
                    "capacity",
                    "soak"
                  ]
                },
                "model": {
                  "type": "string",
                  "enum": [
                    "open",
                    "closed"
                  ]
                },
                "configuration": {
                  "type": "object",
                  "required": [
                    "path",
                    "sha256"
                  ],
                  "properties": {
                    "path": {
                      "$ref": "#/$defs/relativePath"
                    },
                    "sha256": {
                      "$ref": "#/$defs/sha256"
                    }
                  },
                  "additionalProperties": false
                },
                "phases": {
                  "type": "object",
                  "required": [
                    "unit",
                    "warmup",
                    "measurement",
                    "cooldown"
                  ],
                  "properties": {
                    "unit": {
                      "type": "string",
                      "enum": [
                        "seconds",
                        "iterations"
                      ]
                    },
                    "warmup": {
                      "type": "integer",
                      "description": "a non-negative number",
                      "title": "greaterThanOrEqualTo(0)",
                      "minimum": 0
                    },
                    "measurement": {
                      "type": "integer",
                      "description": "a number greater than or equal to 1",
                      "title": "greaterThanOrEqualTo(1)",
                      "minimum": 1
                    },
                    "cooldown": {
                      "type": "integer",
                      "description": "a non-negative number",
                      "title": "greaterThanOrEqualTo(0)",
                      "minimum": 0
                    }
                  },
                  "additionalProperties": false
                },
                "dataset": {
                  "anyOf": [
                    {
                      "type": "object",
                      "required": [
                        "kind"
                      ],
                      "properties": {
                        "kind": {
                          "type": "string",
                          "enum": [
                            "none"
                          ]
                        }
                      },
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "required": [
                        "kind",
                        "id",
                        "version",
                        "sha256",
                        "seed"
                      ],
                      "properties": {
                        "kind": {
                          "type": "string",
                          "enum": [
                            "versioned"
                          ]
                        },
                        "id": {
                          "$ref": "#/$defs/id"
                        },
                        "version": {
                          "$ref": "#/$defs/version"
                        },
                        "sha256": {
                          "$ref": "#/$defs/sha256"
                        },
                        "seed": {
                          "type": "integer",
                          "description": "a non-negative number",
                          "title": "greaterThanOrEqualTo(0)",
                          "minimum": 0
                        }
                      },
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "additionalProperties": false,
              "title": "Versioned workload definition",
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "tool": {
                        "const": "k6"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "phases": {
                        "properties": {
                          "unit": {
                            "const": "seconds"
                          }
                        }
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "tool": {
                        "const": "playwright"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "model": {
                        "const": "closed"
                      },
                      "phases": {
                        "properties": {
                          "unit": {
                            "const": "iterations"
                          }
                        }
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "tool": {
                        "const": "kube-burner"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "model": {
                        "const": "open"
                      },
                      "phases": {
                        "properties": {
                          "unit": {
                            "const": "iterations"
                          }
                        }
                      }
                    }
                  }
                }
              ]
            },
            "uniqueItems": true,
            "description": "an array of at least 1 item(s)",
            "title": "minItems(1)",
            "minItems": 1
          },
          "schedule": {
            "type": "object",
            "required": [],
            "properties": {
              "pr": {
                "$ref": "#/$defs/profile"
              },
              "main": {
                "$ref": "#/$defs/profile"
              },
              "nightly": {
                "$ref": "#/$defs/profile"
              },
              "scheduled": {
                "$ref": "#/$defs/profile"
              },
              "release": {
                "$ref": "#/$defs/profile"
              }
            },
            "additionalProperties": false,
            "minProperties": 1
          },
          "metrics": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "direction"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Metric name following naming convention",
                  "title": "minLength(1)",
                  "minLength": 1,
                  "pattern": "^[a-z][a-z0-9_.]*$"
                },
                "direction": {
                  "type": "string",
                  "enum": [
                    "lower-is-better",
                    "higher-is-better"
                  ],
                  "description": "Whether lower or higher values are better"
                },
                "type": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "latency",
                        "throughput",
                        "error_rate",
                        "resource",
                        "custom"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Metric type",
                  "default": null
                },
                "unit": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Unit of measurement (ms, req/s, %, etc.)",
                  "default": null
                }
              },
              "additionalProperties": false
            },
            "uniqueItems": true,
            "description": "an array of at least 1 item(s)",
            "title": "minItems(1)",
            "minItems": 1
          },
          "source": {
            "type": "object",
            "required": [
              "repository",
              "gitSha",
              "entrypoint"
            ],
            "properties": {
              "repository": {
                "type": "string",
                "format": "uri",
                "description": "a string matching the pattern ^https:\\/\\/",
                "pattern": "^https:\\/\\/"
              },
              "gitSha": {
                "type": "string",
                "description": "a string matching the pattern ^[a-f0-9]{40}$",
                "pattern": "^[a-f0-9]{40}$"
              },
              "entrypoint": {
                "$ref": "#/$defs/relativePath"
              }
            },
            "additionalProperties": false
          },
          "artifact": {
            "$ref": "#/$defs/executionArtifact"
          }
        },
        "additionalProperties": false
      },
      "uniqueItems": true,
      "description": "an array of at least 1 item(s)",
      "title": "minItems(1)",
      "minItems": 1
    }
  },
  "additionalProperties": false,
  "title": "Versioned performance test catalogue with execution provenance"
}
