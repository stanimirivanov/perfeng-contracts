{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perfeng.dev/schemas/candidate/v1/candidate.schema.json",
  "type": "object",
  "required": [
    "gitSha"
  ],
  "properties": {
    "gitSha": {
      "type": "string",
      "description": "Git commit SHA",
      "pattern": "^[A-Fa-f0-9]{40}$"
    },
    "branch": {
      "type": "string",
      "description": "Git branch"
    },
    "imageDigest": {
      "type": "string",
      "description": "Container image digest"
    },
    "version": {
      "type": "string",
      "description": "Application version"
    },
    "configurationHash": {
      "type": "string",
      "description": "Configuration hash"
    },
    "featureFlags": {
      "type": "object",
      "required": [],
      "properties": {},
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "boolean"
          },
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "databaseMigrationVersion": {
      "type": "string",
      "description": "Database migration version"
    },
    "dependencies": {
      "type": "object",
      "required": [],
      "properties": {},
      "additionalProperties": {
        "type": "string"
      },
      "description": "Dependency versions"
    }
  },
  "additionalProperties": false,
  "description": "Candidate software version under test",
  "title": "Candidate Specification"
}
