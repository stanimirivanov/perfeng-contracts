{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perfeng.dev/schemas/run/v1/run-metadata.schema.json",
  "type": "object",
  "required": [
    "run",
    "test",
    "candidate",
    "environment"
  ],
  "properties": {
    "run": {
      "type": "object",
      "required": [
        "id",
        "suite",
        "profile",
        "timestamp",
        "trigger",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique performance run identifier",
          "pattern": "^perf-[0-9]{8}-[0-9]{6}-[a-f0-9]{8}$"
        },
        "suite": {
          "type": "string",
          "description": "Test suite name (e.g., checkout-api, search-flow)",
          "title": "minLength(1)",
          "minLength": 1
        },
        "profile": {
          "type": "string",
          "enum": [
            "smoke",
            "average",
            "regression",
            "stress",
            "capacity",
            "soak"
          ],
          "description": "Workload profile used"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "Run start timestamp in ISO 8601"
        },
        "trigger": {
          "type": "string",
          "enum": [
            "manual",
            "ci",
            "schedule",
            "bisect",
            "release"
          ],
          "description": "What triggered this run"
        },
        "status": {
          "type": "string",
          "enum": [
            "CREATED",
            "VALIDATING",
            "PROVISIONING",
            "WARMING_UP",
            "RUNNING",
            "COLLECTING",
            "ANALYZING",
            "REPORTING",
            "COMPLETED",
            "INVALID",
            "ABORTED",
            "INFRASTRUCTURE_FAILURE",
            "TEST_FAILURE",
            "INCONCLUSIVE"
          ],
          "description": "Current run state"
        },
        "policyVersion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Version of the policy used for evaluation",
          "default": null
        },
        "notes": {
          "anyOf": [
            {
              "type": "string",
              "description": "a string at most 1000 character(s) long",
              "title": "maxLength(1000)",
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional notes about this run",
          "default": null
        }
      },
      "additionalProperties": false
    },
    "test": {
      "type": "object",
      "required": [
        "type",
        "tool",
        "toolVersion",
        "scenario"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "api",
            "browser",
            "kubernetes",
            "infrastructure"
          ],
          "description": "Type of performance test"
        },
        "tool": {
          "type": "string",
          "enum": [
            "k6",
            "playwright",
            "kube-burner",
            "benchmark-operator"
          ],
          "description": "Tool used for testing"
        },
        "toolVersion": {
          "type": "string",
          "description": "Version of the test tool",
          "title": "minLength(1)",
          "minLength": 1
        },
        "scenario": {
          "type": "string",
          "description": "Specific scenario name",
          "title": "minLength(1)",
          "minLength": 1
        },
        "workloadVersion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Version of the workload definition",
          "default": null
        },
        "configHash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Hash of the test configuration",
          "default": null
        }
      },
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "required": [
        "gitSha"
      ],
      "properties": {
        "gitSha": {
          "type": "string",
          "description": "Git commit SHA of the candidate",
          "pattern": "^[A-Fa-f0-9]{40}$"
        },
        "imageDigest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Container image digest",
          "default": null
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Application version string",
          "default": null
        },
        "branch": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Git branch name",
          "default": null
        },
        "configurationHash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Hash of application configuration",
          "default": null
        },
        "featureFlags": {
          "anyOf": [
            {
              "type": "object",
              "required": [],
              "properties": {},
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "Feature flag settings",
          "default": null
        },
        "databaseMigrationVersion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Database migration version",
          "default": null
        }
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "required": [
        "cluster",
        "kubernetesVersion"
      ],
      "properties": {
        "cluster": {
          "type": "string",
          "description": "Cluster name",
          "title": "minLength(1)",
          "minLength": 1
        },
        "kubernetesVersion": {
          "type": "string",
          "description": "Kubernetes version",
          "pattern": "^v?\\d+\\.\\d+\\.\\d+"
        },
        "nodePool": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Node pool identifier",
          "default": null
        },
        "nodeModel": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Node hardware model",
          "default": null
        },
        "cpuArchitecture": {
          "anyOf": [
            {
              "type": "string",
              "description": "a string matching the pattern ^(amd64|arm64)$",
              "pattern": "^(amd64|arm64)$"
            },
            {
              "type": "null"
            }
          ],
          "description": "CPU architecture (e.g., amd64, arm64)",
          "default": null
        },
        "kernel": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Kernel version",
          "default": null
        },
        "containerRuntime": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Container runtime (containerd, cri-o, etc.)",
          "default": null
        },
        "cni": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Container Network Interface",
          "default": null
        },
        "storageClass": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Storage class used",
          "default": null
        },
        "fingerprint": {
          "anyOf": [
            {
              "type": "string",
              "description": "a string matching the pattern ^[a-f0-9]{64}$",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ],
          "description": "Canonical environment fingerprint",
          "default": null
        },
        "nodeCount": {
          "anyOf": [
            {
              "type": "integer",
              "description": "a number greater than or equal to 1",
              "title": "greaterThanOrEqualTo(1)",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ],
          "description": "Number of nodes",
          "default": null
        },
        "region": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Geographic region",
          "default": null
        }
      },
      "additionalProperties": false
    },
    "runtime": {
      "anyOf": [
        {
          "type": "object",
          "required": [],
          "properties": {
            "replicas": {
              "anyOf": [
                {
                  "type": "integer",
                  "description": "a number greater than or equal to 1",
                  "title": "greaterThanOrEqualTo(1)",
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ],
              "description": "Number of replicas",
              "default": null
            },
            "cpuRequests": {
              "anyOf": [
                {
                  "type": "string",
                  "description": "a string matching the pattern ^\\d+(\\.\\d+)?m?$",
                  "pattern": "^\\d+(\\.\\d+)?m?$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "CPU requests (e.g., '500m')",
              "default": null
            },
            "cpuLimits": {
              "anyOf": [
                {
                  "type": "string",
                  "description": "a string matching the pattern ^\\d+(\\.\\d+)?m?$",
                  "pattern": "^\\d+(\\.\\d+)?m?$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "CPU limits",
              "default": null
            },
            "memoryRequests": {
              "anyOf": [
                {
                  "type": "string",
                  "description": "a string matching the pattern ^\\d+(\\.\\d+)?(Ki|Mi|Gi|Ti|K|M|G|T)?$",
                  "pattern": "^\\d+(\\.\\d+)?(Ki|Mi|Gi|Ti|K|M|G|T)?$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Memory requests (e.g., '512Mi')",
              "default": null
            },
            "memoryLimits": {
              "anyOf": [
                {
                  "type": "string",
                  "description": "a string matching the pattern ^\\d+(\\.\\d+)?(Ki|Mi|Gi|Ti|K|M|G|T)?$",
                  "pattern": "^\\d+(\\.\\d+)?(Ki|Mi|Gi|Ti|K|M|G|T)?$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Memory limits",
              "default": null
            },
            "hpa": {
              "anyOf": [
                {
                  "type": "object",
                  "required": [],
                  "properties": {
                    "enabled": {
                      "anyOf": [
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "default": null
                    },
                    "minReplicas": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "description": "a number greater than or equal to 1",
                          "title": "greaterThanOrEqualTo(1)",
                          "minimum": 1
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "default": null
                    },
                    "maxReplicas": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "description": "a number greater than or equal to 1",
                          "title": "greaterThanOrEqualTo(1)",
                          "minimum": 1
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "default": null
                    },
                    "targetCpuUtilization": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "description": "a number between 1 and 100",
                          "title": "between(1, 100)",
                          "minimum": 1,
                          "maximum": 100
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "default": null
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ],
              "description": "Horizontal Pod Autoscaler configuration",
              "default": null
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ],
      "description": "Runtime resource configuration",
      "default": null
    },
    "data": {
      "anyOf": [
        {
          "type": "object",
          "required": [],
          "properties": {
            "datasetId": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Dataset identifier",
              "default": null
            },
            "datasetVersion": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Dataset version",
              "default": null
            },
            "databaseSize": {
              "anyOf": [
                {
                  "type": "string",
                  "description": "a string matching the pattern ^\\d+(\\.\\d+)?(KB|MB|GB|TB|KiB|MiB|GiB|TiB)$",
                  "pattern": "^\\d+(\\.\\d+)?(KB|MB|GB|TB|KiB|MiB|GiB|TiB)$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Database size (e.g., '10GB')",
              "default": null
            },
            "seedVersion": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Data seed version",
              "default": null
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ],
      "description": "Test data information",
      "default": null
    },
    "phases": {
      "anyOf": [
        {
          "type": "object",
          "required": [],
          "properties": {
            "provisionStart": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "warmupStart": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "measurementStart": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "measurementEnd": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "cooldownEnd": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ],
      "description": "Timing information for different phases",
      "default": null
    }
  },
  "additionalProperties": false,
  "description": "Complete metadata for a single performance test run",
  "title": "Performance Run Metadata"
}
