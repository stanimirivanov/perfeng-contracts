{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perfeng.dev/schemas/result/v1/test-result.schema.json",
  "$defs": {
    "ResultThresholds": {
      "type": "object",
      "required": [],
      "properties": {
        "slo": {
          "anyOf": [
            {
              "type": "object",
              "required": [],
              "properties": {},
              "additionalProperties": {
                "$ref": "#/$defs/SloThreshold"
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "SLO threshold results",
          "default": null
        },
        "regression": {
          "anyOf": [
            {
              "type": "object",
              "required": [],
              "properties": {},
              "additionalProperties": {
                "$ref": "#/$defs/RegressionThreshold"
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "Regression threshold results",
          "default": null
        }
      },
      "additionalProperties": false
    },
    "SloThreshold": {
      "type": "object",
      "required": [
        "passed"
      ],
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "actual": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "additionalProperties": false
    },
    "RegressionThreshold": {
      "type": "object",
      "required": [
        "passed"
      ],
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "baselineValue": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "actualValue": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "percentChange": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "additionalProperties": false
    },
    "ResultMetadata": {
      "type": "object",
      "required": [],
      "properties": {},
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      }
    },
    "JsonValue": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JsonValue"
          }
        },
        {
          "type": "object",
          "required": [],
          "properties": {},
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          }
        }
      ]
    }
  },
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "metric",
    "distribution"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1,
      "description": "Schema version"
    },
    "runId": {
      "type": "string",
      "description": "Reference to the run metadata",
      "pattern": "^perf-[0-9]{8}-[0-9]{6}-[a-f0-9]{8}$"
    },
    "metric": {
      "type": "object",
      "required": [
        "name",
        "direction"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Metric name following naming convention",
          "title": "minLength(1)",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.]*$"
        },
        "direction": {
          "type": "string",
          "enum": [
            "lower-is-better",
            "higher-is-better"
          ],
          "description": "Whether lower or higher values are better"
        },
        "type": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "latency",
                "throughput",
                "error_rate",
                "resource",
                "custom"
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "Metric type",
          "default": null
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Unit of measurement (ms, req/s, %, etc.)",
          "default": null
        }
      },
      "additionalProperties": false
    },
    "distribution": {
      "type": "object",
      "required": [
        "samples"
      ],
      "properties": {
        "samples": {
          "type": "integer",
          "description": "Number of samples",
          "title": "greaterThanOrEqualTo(1)",
          "minimum": 1
        },
        "mean": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Arithmetic mean",
          "default": null
        },
        "median": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Median (p50)",
          "default": null
        },
        "p90": {
          "anyOf": [
            {
              "type": "number",
              "description": "a non-negative number",
              "title": "greaterThanOrEqualTo(0)",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ],
          "description": "90th percentile",
          "default": null
        },
        "p95": {
          "anyOf": [
            {
              "type": "number",
              "description": "a non-negative number",
              "title": "greaterThanOrEqualTo(0)",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ],
          "description": "95th percentile",
          "default": null
        },
        "p99": {
          "anyOf": [
            {
              "type": "number",
              "description": "a non-negative number",
              "title": "greaterThanOrEqualTo(0)",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ],
          "description": "99th percentile",
          "default": null
        },
        "stddev": {
          "anyOf": [
            {
              "type": "number",
              "description": "a non-negative number",
              "title": "greaterThanOrEqualTo(0)",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ],
          "description": "Standard deviation",
          "default": null
        },
        "min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Minimum value",
          "default": null
        },
        "max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Maximum value",
          "default": null
        },
        "cv": {
          "anyOf": [
            {
              "type": "number",
              "description": "a non-negative number",
              "title": "greaterThanOrEqualTo(0)",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ],
          "description": "Coefficient of variation",
          "default": null
        }
      },
      "additionalProperties": false
    },
    "thresholds": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResultThresholds"
        },
        {
          "type": "null"
        }
      ],
      "description": "Threshold evaluation results",
      "default": null
    },
    "metadata": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResultMetadata"
        },
        {
          "type": "null"
        }
      ],
      "description": "Additional metadata",
      "default": null
    }
  },
  "additionalProperties": false,
  "description": "Normalized performance test result independent of tool",
  "title": "Normalized Test Result"
}
